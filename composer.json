{
    "name": "matchory/template-laravel",
    "type": "project",
    "description": "Matchory Laravel application template.",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.23",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "larastan/larastan": "^3.10",
        "matchory/coding-style": "^0.1.2",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "fmt": "pint --config vendor/matchory/coding-style/php/pint/base.json --parallel --cache-file=./.cache/pint.json",
        "fmt:test": "@fmt --test",
        "fmt:pre-commit": "@fmt --dirty --repair",
        "lint": "@analyze",
        "analyze": "phpstan analyse --memory-limit=-1",
        "analyze:ci": "@analyze --no-progress --ansi",
        "rector": "rector process",
        "rector:ci": "@rector --dry-run --no-progress-bar",
        "test": "pest",
        "test:ci": "@test --colors=always",
        "style:sync": "matchory-coding-style sync",
        "style:verify": "matchory-coding-style verify --strict",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
